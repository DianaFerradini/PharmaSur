# Modèle du fichier .env (D38).
# Copier ce fichier en .env, puis remplir les valeurs. Le fichier .env n'est jamais commité.
# Sur Railway, saisir les mêmes variables dans l'onglet Variables du service.

# --- WhatsApp (Meta Cloud API, D29) ---
# Jeton d'accès permanent de l'« utilisateur système » (le jeton temporaire expire en moins de 24 h).
WHATSAPP_TOKEN=
# Identifiant du numéro de téléphone du bot (« Phone number ID » dans le tableau de bord Meta).
WHATSAPP_PHONE_NUMBER_ID=
# Mot de passe choisi par l'équipe, à recopier à l'identique dans la configuration du webhook chez Meta.
WHATSAPP_VERIFY_TOKEN=
# Secret de l'application Meta (« App secret »), qui sert à vérifier la signature des messages reçus.
WHATSAPP_APP_SECRET=
# Facultatif : version de l'API Graph de Meta.
# WHATSAPP_API_VERSION=v25.0

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# Facultatif : un modèle par tâche (D39). Les valeurs ci-dessous sont celles par défaut.
# CLAUDE_MODELE_TRI=claude-haiku-5-5
# CLAUDE_MODELE_EXTRACTION=claude-haiku-5-5
# CLAUDE_MODELE_PHOTO=claude-opus-5-5
# CLAUDE_MODELE_PHARMACIE=claude-haiku-5-5

# --- Transcription du wolof (ElevenLabs Scribe, D32) ---
ELEVENLABS_API_KEY=

# --- Données ---
# Vrai numéro WhatsApp du téléphone qui joue la Pharmacie Baobab, au format international
# (par exemple +221 77 123 45 67). Les autres pharmacies ont des numéros fictifs.
NUMERO_PHARMACIE_BAOBAB=
# Chemin du fichier SQLite (D35). Il est créé avec les données simulées s'il n'existe pas.
DB_PATH=pharmasur.db
